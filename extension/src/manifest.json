{
  "manifest_version": 3,
  "name": "Zeno: record your screen",
  "version": "0.0.0",
  "description": "Record your screen, camera and microphone. Saved as separate tracks, ready to edit.",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_title": "Record with Zeno", "default_popup": "popup.html", "default_icon": { "16": "icons/16.png", "32": "icons/32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["offscreen", "downloads", "storage", "unlimitedStorage", "activeTab", "scripting", "clipboardWrite"],
  "web_accessible_resources": [{ "resources": ["bubble.html", "bubble.js"], "matches": ["<all_urls>"] }]
}
