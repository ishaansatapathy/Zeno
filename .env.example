# Copy to .env for local development. Never commit real values.
APP_ENV=development

# 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 first and every new
# connection stalls ~2s. Host port 5433 avoids a Postgres already installed on 5432.
DATABASE_URL=postgres://zeno:zeno@127.0.0.1:5433/zeno
REDIS_URL=redis://127.0.0.1:6379

# Where the web app lives; used for CORS, the CSRF origin check and email links.
CLIENT_URL=http://localhost:3000

# Signs short-lived access tokens. At least 32 bytes, random, unique per environment.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# Set true in production (HTTPS only).
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (Caddy, CDN). 0 = trust the socket address only.
TRUSTED_PROXY_HOPS=0

# S3-compatible storage (MinIO in docker-compose). Browsers receive presigned URLs built from
# S3_PUBLIC_ENDPOINT, which defaults to S3_ENDPOINT.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=zeno-media
S3_ACCESS_KEY=zeno-dev
S3_SECRET_KEY=zeno-dev-secret
S3_REGION=us-east-1
S3_PATH_STYLE=true

# Limits (defaults shown). The worker also reads FFMPEG_BIN, FFPROBE_BIN, WORK_DIR,
# WORKER_CONCURRENCY, ENCODE_THREADS, MAX_DURATION_SECS (21600) and MAX_DIMENSION (4096).
# MAX_UPLOAD_BYTES=10737418240
# Days an original upload is kept after the video is ready (or failed) before it is deleted.
# SOURCE_RETENTION_DAYS=7

# Wraps every video's content key before it is stored (AES-256-GCM). Needed by the worker, and
# later by the key server. 32 random bytes, base64. Losing it makes every stored key unreadable,
# so keep it in your secret manager, and never reuse a value across environments.
#   openssl rand -base64 32
CONTENT_KEY_SECRET=
# Rotation (preferred once a deployment exists): comma-separated version:base64 entries. New
# keys use CONTENT_KEY_ACTIVE; retained versions keep old videos playable. When set, this
# replaces CONTENT_KEY_SECRET.
# CONTENT_KEY_SECRETS=1:<old-base64>,2:<new-base64>
# CONTENT_KEY_ACTIVE=2

# Playback. The API signs playback tokens and the key server checks them, so both need the same
# secret: at least 32 random bytes (openssl rand -base64 48).
PLAYBACK_TOKEN_SECRET=
# Rolling rotation alternative. Deploy verifiers with both entries before switching ACTIVE;
# legacy v1 tokens and tokens signed by retained keys remain valid until their sessions end.
# PLAYBACK_TOKEN_SECRETS=1:<old-secret>,2:<new-secret>
# PLAYBACK_TOKEN_ACTIVE=2
# Where players fetch content keys (zeno-keyserver). Must be https in production.
KEY_SERVER_URL=http://localhost:8081
# MAX_CONCURRENT_STREAMS=2
# KEYSERVER_BIND_ADDR=0.0.0.0:8081
# Distributed key-delivery abuse limits (Redis-backed and fail closed if Redis is unavailable).
# KEY_IP_LIMIT_PER_MINUTE=120
# KEY_USER_LIMIT_PER_DAY=1000

# Where course and avatar images are served from: a CDN in front of the bucket, no trailing
# slash. Unset, the API hands out presigned links to the private bucket (good for an hour).
# IMAGE_BASE_URL=https://img.example.com
