# Copy to .env for local development. Never commit real values.
APP_ENV=development

# 127.0.0.1 rather than localhost: on Windows "localhost" tries IPv6 first and every new
# connection stalls ~2s. Host port 5433 avoids a Postgres already installed on 5432.
DATABASE_URL=postgres://zeno:zeno@127.0.0.1:5433/zeno
REDIS_URL=redis://127.0.0.1:6379

# Where the web app lives; used for CORS, the CSRF origin check and email links.
CLIENT_URL=http://localhost:3000

# Signs short-lived access tokens. At least 32 bytes, random, unique per environment.
#   openssl rand -base64 48
JWT_ACCESS_SECRET=

# Set true in production (HTTPS only).
COOKIE_SECURE=false

# Number of reverse proxies in front of the API (Caddy, CDN). 0 = trust the socket address only.
TRUSTED_PROXY_HOPS=0
